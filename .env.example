# Copy to .env and adjust. NEVER commit .env.
# These values are for LOCAL DEVELOPMENT ONLY.

# --- MariaDB (used by docker-compose.yml) ---
MARIADB_ROOT_PASSWORD=change-me-root-local-only
MARIADB_DATABASE=marketforge
MARIADB_USER=marketforge
MARIADB_PASSWORD=change-me-local-only
MARIADB_PORT=3306

# --- API ---
# go-sql-driver/mysql DSN. parseTime/loc/time_zone are added by the app.
MF_DATABASE_DSN=marketforge:change-me-local-only@tcp(127.0.0.1:3306)/marketforge
MF_HTTP_ADDR=:8080
MF_SESSION_TTL=168h
# true whenever the site is served over HTTPS (any real deployment)
MF_COOKIE_SECURE=false
MF_BCRYPT_COST=12
MF_LOG_LEVEL=info

# --- Integration tests ---
# The database name MUST end with _test: the test suite DROPS and recreates it.
MF_TEST_DATABASE_DSN=marketforge:change-me-local-only@tcp(127.0.0.1:3306)/marketforge_test
